# 复制为 .env 或直接 export；均可用环境变量覆盖 config.yaml
TR_DATABASE_DSN=host=localhost port=5432 user=postgres password=postgres dbname=team_router sslmode=disable
TR_SERVER_ADDR=:8080
TR_AUTH_JWT_SECRET=change-me-in-production
# 32 字节 hex：openssl rand -hex 32
TR_CRYPTO_MASTER_KEY=
TR_LOG_LEVEL=info
TR_LOG_DEV=true
TR_CONFIG=/etc/team-router/config.yaml
